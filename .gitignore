# =============================================================================
# PROJECT SPECIFIC EXCEPTIONS
# =============================================================================
# Explicitly ALLOW binary files located in the lib folder
# These are pre-built dependencies required for the project
!lib/**/*.dll
!lib/**/*.lib
!lib/**/*.pdb