## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/master/VisualStudio.gitignore

# =============================================================================
# CMAKE
# =============================================================================

# Build directories
[Bb]uild/
[Bb]uild[Dd]ebug/
[Bb]uild[Rr]elease/
cmake-build-*/
out/
out/[Bb]uild/

# CMake generated files
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
CTestTestfile.cmake
CMakeSettings.json
CMakePresets.json
CMakeUserPresets.json
compile_commands.json
install_manifest.txt

# Keep CMakeLists.txt but ignore other cmake files
*.cmake
!CMakeLists.txt

# CMake build output
Makefile
*.make

# =============================================================================
# PROJECT SPECIFIC - CustomUPC / UPS Monitor
# =============================================================================

# Binary output directory
bin/
bin/Debug/
bin/Release/

# Application logs
*.log
logs/
debug_log.txt
ups_state.txt

# Configuration files with sensitive data
*.config.local
*.secrets
appsettings.local.json

